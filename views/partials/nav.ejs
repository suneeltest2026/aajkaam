<%- include('./icons') %>
<header class="site-header">
  <span class="wordmark"><svg class="ic" width="18" height="18"><use href="#i-hardhat"></use></svg>AAJKAAM</span>
</header>
<% if (typeof user !== 'undefined' && user) { %>
<div class="nav-links">
  <% if (user.role === 'worker') { %>
    <a href="/worker" class="role-worker <%= typeof current !== 'undefined' && current === 'worker' ? 'is-active' : '' %>">My Work</a>
  <% } %>
  <% if (user.role === 'supervisor' || user.role === 'management') { %>
    <a href="/entry" class="role-supervisor <%= typeof current !== 'undefined' && current === 'entry' ? 'is-active' : '' %>">Daily Entry</a>
    <a href="/entry/report" class="role-supervisor <%= typeof current !== 'undefined' && current === 'report' ? 'is-active' : '' %>">Report</a>
  <% } %>
  <% if (user.role === 'management') { %>
    <a href="/setup" class="role-supervisor <%= typeof current !== 'undefined' && current === 'setup' ? 'is-active' : '' %>">Setup</a>
    <a href="/management" class="role-management <%= typeof current !== 'undefined' && current === 'management' ? 'is-active' : '' %>">Management</a>
  <% } %>
  <span style="margin-left:auto;display:flex;align-items:center;gap:10px;padding:0 8px;">
    <span style="font-size:12.5px;color:var(--steel);white-space:nowrap;"><%= user.name %></span>
    <form method="POST" action="/logout" style="margin:0;">
      <button type="submit" style="width:auto;min-height:0;margin:0;padding:8px 12px;font-size:12.5px;background:var(--app-bg);color:var(--ink);">Log out</button>
    </form>
  </span>
</div>
<% } %>
