<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Report</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'report'}) %>
  <main>
    <div class="card">
      <h2>Daily Entries Report</h2>
      <form method="GET" action="/entry/report">
        <label>From</label>
        <input type="date" name="from" value="<%= from %>">
        <label>To</label>
        <input type="date" name="to" value="<%= to %>">
        <button type="submit">Filter</button>
      </form>
      <p style="margin-top:20px;">
        <a href="/entry/report/export.csv?from=<%= from %>&to=<%= to %>">⬇ Download as Excel (CSV)</a>
      </p>
    </div>

    <div class="card">
      <div class="table-wrap">
      <table>
        <tr>
          <th>Date</th><th>Project</th><th>Crew</th><th>Activity</th>
          <th>Stage</th><th>Units</th><th>Hours</th><th>Entered By</th>
        </tr>
        <% entries.forEach(e => { %>
          <tr>
            <td><%= e.entry_date.toISOString().slice(0,10) %></td>
            <td><%= e.project_name || '—' %></td>
            <td><%= e.crew_name || '—' %></td>
            <td><%= e.activity_name || '—' %></td>
            <td><%= e.stage_name || '—' %></td>
            <td><%= e.units_completed %></td>
            <td><%= e.hours_worked || '—' %></td>
            <td><%= e.entered_by %></td>
          </tr>
        <% }) %>
      </table>
      </div>
    </div>
  </main>
</body>
</html>
