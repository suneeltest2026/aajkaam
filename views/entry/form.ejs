<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AajKaam — Daily Entry</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'entry'}) %>
  <main>
    <div class="card">
      <h2>Today's Work</h2>
      <% if (taggedProject) { %>
        <span class="pill pill--neutral" style="margin-bottom:14px;">
          <svg class="ic-sm" width="12" height="12"><use href="#i-building"></use></svg>
          <%= taggedProject.name %><% if (taggedProject.location) { %> &middot; <%= taggedProject.location %><% } %>
        </span>
      <% } %>
      <% if (typeof saved !== 'undefined') { %>
        <p class="pill pill--good" style="margin-bottom:10px;"><svg class="ic-sm" width="12" height="12"><use href="#i-check"></use></svg>Saved successfully</p>
      <% } %>
      <% if (error === 'worker') { %>
        <p class="auth-error">That worker isn't tagged to your project — ask Management to link them in Setup &rarr; Workers.</p>
      <% } %>
      <% if (!workers.length) { %>
        <p style="color:var(--steel);">No workers are tagged to your project yet — ask Management to link one to you in Setup &rarr; Workers.</p>
      <% } else { %>
      <form method="POST" action="/entry">
        <label>Date</label>
        <input type="date" name="entry_date" value="<%= today %>" required>

        <label>Worker</label>
        <select name="worker_id" id="workerSelect" required>
          <option value="">-- Select Worker --</option>
          <% workers.forEach(w => { %>
            <option value="<%= w.id %>"><%= w.name %><% if (w.trade_name) { %> (<%= w.trade_name %>)<% } %></option>
          <% }) %>
        </select>

        <label>Project / Site</label>
        <input type="text" id="projectField" value="" readonly placeholder="Pick a worker above">

        <label>Activity</label>
        <select name="activity_id" id="activitySelect" required>
          <option value="">-- Select Activity --</option>
          <% activities.forEach(a => { %>
            <option value="<%= a.id %>"><%= a.name %></option>
          <% }) %>
        </select>

        <label>Entered By</label>
        <input type="text" value="<%= enteredByName %>" readonly>

        <div id="stagesContainer" style="margin-top:20px;"></div>

        <button type="submit">Save Today's Entry</button>
      </form>
      <% } %>
    </div>
  </main>

  <script>
    const workerSelect = document.getElementById('workerSelect');
    const projectField = document.getElementById('projectField');
    const activitySelect = document.getElementById('activitySelect');
    const container = document.getElementById('stagesContainer');

    function step(input, delta) {
      const val = (parseFloat(input.value) || 0) + delta;
      input.value = Math.max(0, Math.round(val * 100) / 100);
    }

    workerSelect.addEventListener('change', async () => {
      projectField.value = '';
      const workerId = workerSelect.value;
      if (!workerId) return;
      const res = await fetch('/entry/worker-project/' + workerId);
      const { project } = await res.json();
      projectField.value = project ? project.name + (project.location ? ' · ' + project.location : '') : 'No project set';
    });

    activitySelect.addEventListener('change', async () => {
      container.innerHTML = '';
      const activityId = activitySelect.value;
      if (!activityId) return;
      const res = await fetch('/entry/stages/' + activityId);
      const stages = await res.json();
      stages.forEach((stage, i) => {
        const row = document.createElement('div');
        row.className = 'card stage-card';
        row.innerHTML = `
          <div class="stage-card-head">
            <p class="card-title" style="font-weight:700;margin:0;">${i + 1}. ${stage.name}</p>
            <span class="weight-badge">${stage.weight_percent}% wt.</span>
          </div>
          <input type="hidden" name="stage_ids" value="${stage.id}">

          <p class="field-label">Units completed</p>
          <div class="stepper">
            <button type="button" class="step-btn" data-delta="-1" aria-label="Decrease">&minus;</button>
            <input type="number" step="0.01" name="units" placeholder="0" inputmode="decimal">
            <button type="button" class="step-btn" data-delta="1" aria-label="Increase">+</button>
          </div>

          <p class="field-label">Hours worked</p>
          <div class="stepper">
            <button type="button" class="step-btn" data-delta="-0.5" aria-label="Decrease">&minus;</button>
            <input type="number" step="0.01" name="hours" placeholder="0" inputmode="decimal">
            <button type="button" class="step-btn" data-delta="0.5" aria-label="Increase">+</button>
          </div>
        `;
        container.appendChild(row);
      });
      container.querySelectorAll('.step-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const input = btn.parentElement.querySelector('input');
          step(input, parseFloat(btn.dataset.delta));
        });
      });
    });
  </script>
</body>
</html>
