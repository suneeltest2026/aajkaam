<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — <%= worker.name %></title><link rel="stylesheet" href="/style.css"></head>
<body class="role-worker">
  <%- include('../partials/nav', {current: 'worker'}) %>
  <main>
    <div class="card" style="display:flex;align-items:center;justify-content:space-between;">
      <div>
        <p style="margin:0;font-size:19px;font-weight:700;"><%= worker.name %></p>
        <p style="margin:2px 0 0;font-size:12.5px;color:var(--steel);"><%= worker.trade_name || 'Worker' %></p>
      </div>
      <span style="font-family:var(--mono);font-size:12.5px;color:var(--steel);"><%= today %></span>
    </div>

    <% if (!crews.length) { %>
      <div class="card"><p style="color:var(--steel);margin:0;">Not assigned to a crew yet — ask your supervisor to add you in <a href="/setup/crews">Setup &rarr; Crews</a>.</p></div>
    <% } %>

    <% crews.forEach(crew => { %>
      <div class="card">
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
          <% if (crew.loggedToday) { %>
            <span class="pill pill--good"><svg class="ic-sm" width="12" height="12"><use href="#i-check"></use></svg>Crew logged today</span>
          <% } else { %>
            <span class="pill pill--neutral"><svg class="ic-sm" width="12" height="12"><use href="#i-clock"></use></svg>No entry yet today</span>
          <% } %>
          <span class="pill pill--neutral"><svg class="ic-sm" width="12" height="12"><use href="#i-crew"></use></svg><%= crew.name %> &middot; <%= crew.activity_name %></span>
          <% if (crew.projectName) { %>
            <span class="pill pill--neutral"><svg class="ic-sm" width="12" height="12"><use href="#i-building"></use></svg><%= crew.projectName %></span>
          <% } %>
        </div>

        <% if (!crew.stages.length) { %>
          <p style="color:var(--steel);font-size:13.5px;margin:0;">No stages recorded for this crew yet today.</p>
        <% } else { %>
          <% crew.stages.forEach((s, i) => { %>
            <p class="field-label" style="margin-top:<%= i === 0 ? '0' : '18px' %>;"><%= s.stage_name %></p>
            <% if (s.target) { %>
              <div class="bignum-row"><span class="bignum"><%= s.units %></span><span class="bignum-of">/ <%= s.target %> units</span></div>
              <div class="bar"><div class="bar-fill" style="width:<%= s.percent %>%"></div></div>
              <p class="bar-caption"><%= s.percent %>% of today's target</p>
            <% } else { %>
              <div class="bignum-row"><span class="bignum"><%= s.units %></span><span class="bignum-of">units &middot; no target set</span></div>
            <% } %>
          <% }) %>

          <div class="tworow" style="margin-top:18px;">
            <div class="card card--stat">
              <svg class="ic" width="18" height="18"><use href="#i-clock"></use></svg>
              <p class="stat-num"><%= crew.totalHours %><span class="stat-unit">hrs</span></p>
              <p class="stat-cap">Logged today</p>
            </div>
            <div class="card card--stat card--accent">
              <p class="stat-num"><%= crew.incentive_share_percent %><span class="stat-unit">%</span></p>
              <p class="stat-cap">Your incentive share</p>
            </div>
          </div>
        <% } %>
      </div>
    <% }) %>
  </main>
</body>
</html>
