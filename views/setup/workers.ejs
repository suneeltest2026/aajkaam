<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Workers</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <p style="margin:0 0 16px;"><a href="/setup">&larr; Back to Setup</a></p>
    <div class="card">
      <h2>New Worker</h2>
      <form method="POST" action="/setup/workers">
        <label>Worker Name</label>
        <input type="text" name="name" required>
        <label>Trade</label>
        <select name="trade_id" required>
          <% trades.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
        </select>
        <label>Skill Level</label>
        <select name="skill_level_id" required>
          <% skillLevels.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
        <button type="submit">Add Worker</button>
      </form>
    </div>
    <div class="card">
      <h3>Workers</h3>
      <% workers.forEach(w => { %>
        <div class="list-row">
          <div class="list-row-head">
            <span class="list-row-name"><%= w.name %></span>
            <% if (w.trade_name) { %><span class="pill pill--neutral"><%= w.trade_name %></span><% } %>
            <% if (w.skill_level_name) { %><span class="pill pill--neutral"><%= w.skill_level_name %></span><% } %>
          </div>
          <div class="list-row-meta">
            <span>Project: <%= w.project_name || 'Not tagged' %></span>
          </div>
          <div class="list-row-actions">
            <form method="POST" action="/setup/workers/<%= w.id %>/link-project">
              <select name="project_id">
                <option value="">-- No project --</option>
                <% projects.forEach(p => { %>
                  <option value="<%= p.id %>" <%= w.project_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                <% }) %>
              </select>
              <button type="submit">Link</button>
            </form>
          </div>
        </div>
      <% }) %>
      <% if (!workers.length) { %><p style="color:var(--steel);">No workers yet.</p><% } %>
    </div>
  </main>
</body>
</html>
