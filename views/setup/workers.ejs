<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Workers</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <div class="card">
      <h2>New Worker</h2>
      <form method="POST" action="/setup/workers">
        <label>Worker Name</label>
        <input type="text" name="name" required>
        <label>Trade</label>
        <select name="trade_id" required>
          <% trades.forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
        </select>
        <label>Skill Level</label>
        <select name="skill_level_id" required>
          <% skillLevels.forEach(s => { %><option value="<%= s.id %>"><%= s.name %></option><% }) %>
        </select>
        <button type="submit">Add Worker</button>
      </form>
    </div>
    <div class="card">
      <h3>Workers</h3>
      <div class="table-wrap">
      <table>
        <tr><th>Name</th><th>Trade</th><th>Skill Level</th><th>Project</th><th></th></tr>
        <% workers.forEach(w => { %>
          <tr>
            <td><%= w.name %></td>
            <td><%= w.trade_name %></td>
            <td><%= w.skill_level_name %></td>
            <td><%= w.project_name || '—' %></td>
            <td>
              <form method="POST" action="/setup/workers/<%= w.id %>/link-project" style="display:flex;gap:6px;align-items:center;margin:0;">
                <select name="project_id" style="min-height:36px;width:auto;">
                  <option value="">-- No project --</option>
                  <% projects.forEach(p => { %>
                    <option value="<%= p.id %>" <%= w.project_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                  <% }) %>
                </select>
                <button type="submit" style="width:auto;min-height:36px;margin:0;padding:0 12px;font-size:12.5px;">Link</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table>
      </div>
    </div>
  </main>
</body>
</html>
