<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Projects</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <div class="card">
      <h2>Project Types</h2>
      <form method="POST" action="/setup/project-types">
        <label>New Project Type</label>
        <input type="text" name="name" placeholder="e.g. Villa" required>
        <button type="submit">Add Project Type</button>
      </form>
      <div class="table-wrap">
      <table>
        <tr><th>Project Type</th></tr>
        <% projectTypes.forEach(pt => { %><tr><td><%= pt.name %></td></tr><% }) %>
      </table>
      </div>
    </div>
    <div class="card">
      <h2>New Project / Site</h2>
      <form method="POST" action="/setup/projects">
        <label>Project Name</label>
        <input type="text" name="name" placeholder="e.g. Marina Towers - Block A" required>
        <label>Project Type</label>
        <select name="project_type_id">
          <option value="">-- None --</option>
          <% projectTypes.forEach(pt => { %><option value="<%= pt.id %>"><%= pt.name %></option><% }) %>
        </select>
        <button type="submit">Add Project</button>
      </form>
    </div>
    <div class="card">
      <h3>Active Projects</h3>
      <div class="table-wrap">
      <table>
        <tr><th>Project</th><th>Type</th></tr>
        <% projects.forEach(p => { %>
          <tr><td><%= p.name %></td><td><%= p.project_type_name || '—' %></td></tr>
        <% }) %>
      </table>
      </div>
    </div>
  </main>
</body>
</html>
