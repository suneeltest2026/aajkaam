<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Users</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <p style="margin:0 0 16px;"><a href="/setup">&larr; Back to Setup</a></p>
    <% if (error === 'mismatch') { %><p class="auth-error">PIN and confirmation didn't match — try again.</p><% } %>

    <div class="card">
      <h2>Logins</h2>
      <p style="color:var(--steel);">Each person gets their own name and PIN. A worker's login is separate from their profile in Setup &rarr; Workers — add the profile first, then a login here if they need app access.</p>
      <% users.forEach(u => { %>
        <div class="list-row">
          <div class="list-row-head">
            <span class="list-row-name"><%= u.name %></span>
            <span class="pill pill--neutral" style="text-transform:capitalize;"><%= u.role %></span>
            <span class="status" style="<%= u.is_active ? 'background:var(--good-bg);color:var(--good);' : 'background:var(--app-bg);color:var(--steel);' %>"><%= u.is_active ? 'Active' : 'Deactivated' %></span>
          </div>
          <% if (u.role === 'supervisor') { %>
            <div class="list-row-meta"><span>Project: <%= u.project_name || 'Not tagged' %></span></div>
          <% } %>
          <div class="list-row-actions">
            <% if (u.role === 'supervisor') { %>
              <form method="POST" action="/setup/users/<%= u.id %>/link-project">
                <select name="project_id">
                  <option value="">-- No project --</option>
                  <% projects.forEach(p => { %>
                    <option value="<%= p.id %>" <%= u.project_id === p.id ? 'selected' : '' %>><%= p.name %></option>
                  <% }) %>
                </select>
                <button type="submit">Link</button>
              </form>
            <% } %>
            <form method="POST" action="/setup/users/<%= u.id %>/reset-pin">
              <input type="password" name="pin" placeholder="New PIN" inputmode="numeric" minlength="4" maxlength="6" required>
              <input type="password" name="confirm_pin" placeholder="Confirm" inputmode="numeric" minlength="4" maxlength="6" required>
              <button type="submit">Reset PIN</button>
            </form>
            <form method="POST" action="/setup/users/<%= u.id %>/toggle-active">
              <button type="submit" style="background:var(--app-bg);color:var(--ink);"><%= u.is_active ? 'Deactivate' : 'Reactivate' %></button>
            </form>
          </div>
        </div>
      <% }) %>
      <% if (!users.length) { %><p style="color:var(--steel);">No logins yet.</p><% } %>
    </div>

    <div class="card">
      <h3>Add Management login</h3>
      <form method="POST" action="/setup/users/management">
        <label>Name</label>
        <input type="text" name="name" required>
        <label>PIN</label>
        <input type="password" name="pin" inputmode="numeric" minlength="4" maxlength="6" required>
        <label>Confirm PIN</label>
        <input type="password" name="confirm_pin" inputmode="numeric" minlength="4" maxlength="6" required>
        <button type="submit">Add Management Login</button>
      </form>
    </div>

    <div class="card">
      <h3>Add Supervisor login</h3>
      <form method="POST" action="/setup/users/supervisor">
        <label>Name</label>
        <input type="text" name="name" required>
        <label>PIN</label>
        <input type="password" name="pin" inputmode="numeric" minlength="4" maxlength="6" required>
        <label>Confirm PIN</label>
        <input type="password" name="confirm_pin" inputmode="numeric" minlength="4" maxlength="6" required>
        <button type="submit">Add Supervisor Login</button>
      </form>
    </div>

    <div class="card">
      <h3>Add Worker login</h3>
      <% if (!availableWorkers.length) { %>
        <p style="color:var(--steel);">Every active worker already has a login, or none exist yet — add worker profiles in <a href="/setup/workers">Setup &rarr; Workers</a> first.</p>
      <% } else { %>
        <form method="POST" action="/setup/users/worker">
          <label>Worker</label>
          <select name="worker_id" required>
            <% availableWorkers.forEach(w => { %><option value="<%= w.id %>"><%= w.name %></option><% }) %>
          </select>
          <label>PIN</label>
          <input type="password" name="pin" inputmode="numeric" minlength="4" maxlength="6" required>
          <label>Confirm PIN</label>
          <input type="password" name="confirm_pin" inputmode="numeric" minlength="4" maxlength="6" required>
          <button type="submit">Add Worker Login</button>
        </form>
      <% } %>
    </div>
  </main>
</body>
</html>
