<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Trades</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <p style="margin:0 0 16px;"><a href="/setup">&larr; Back to Setup</a></p>
    <div class="card">
      <h2>Trades</h2>
      <form method="POST" action="/setup/trades">
        <label>New Trade Name</label>
        <input type="text" name="name" placeholder="e.g. Mason" required>
        <button type="submit">Add Trade</button>
      </form>
      <div class="table-wrap">
      <table>
        <tr><th>Trade</th></tr>
        <% trades.forEach(t => { %><tr><td><%= t.name %></td></tr><% }) %>
      </table>
      </div>
    </div>

    <div class="card">
      <h2>Skill Levels</h2>
      <form method="POST" action="/setup/skill-levels">
        <label>New Skill Level Name</label>
        <input type="text" name="name" placeholder="e.g. Skilled, Semi-Skilled, Helper" required>
        <button type="submit">Add Skill Level</button>
      </form>
      <div class="table-wrap">
      <table>
        <tr><th>Skill Level</th></tr>
        <% skillLevels.forEach(s => { %><tr><td><%= s.name %></td></tr><% }) %>
      </table>
      </div>
    </div>
  </main>
</body>
</html>
