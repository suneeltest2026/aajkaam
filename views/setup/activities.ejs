<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Activities</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <div class="card">
      <h2>New Activity</h2>
      <form method="POST" action="/setup/activities">
        <label>Activity Name</label>
        <input type="text" name="name" placeholder="e.g. Ceiling Work" required>
        <label>Unit</label>
        <input type="text" name="unit" placeholder="sqm" value="sqm">
        <button type="submit">Add Activity</button>
      </form>
    </div>

    <% activities.forEach(a => { %>
    <div class="card">
      <h3><%= a.name %> (<%= a.unit %>)</h3>
      <div class="table-wrap">
      <table>
        <tr><th>Stage</th><th>Weight %</th><th>Order</th></tr>
        <% stages.filter(s => s.activity_id === a.id).forEach(s => { %>
          <tr><td><%= s.name %></td><td><%= s.weight_percent %>%</td><td><%= s.sequence_order %></td></tr>
        <% }) %>
      </table>
      </div>
      <form method="POST" action="/setup/activities/<%= a.id %>/stages" style="margin-top:16px;">
        <label>Stage Name</label>
        <input type="text" name="stage_name" placeholder="e.g. Framing" required>
        <label>Weight (%)</label>
        <input type="number" step="0.01" name="weight_percent" placeholder="40" required>
        <label>Order</label>
        <input type="number" name="sequence_order" placeholder="1" required>
        <button type="submit">Add Stage</button>
      </form>
    </div>
    <% }) %>
  </main>
</body>
</html>
