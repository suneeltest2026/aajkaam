<!DOCTYPE html>
<html>
<head><title>AajKaam — Crews</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <header><h1>AAJKAAM</h1></header>
  <div class="nav-links"><a href="/entry">Daily Entry</a><a href="/setup">Setup</a></div>
  <main>
    <div class="card">
      <h2>New Crew</h2>
      <form method="POST" action="/setup/crews">
        <label>Crew Name</label>
        <input type="text" name="name" placeholder="e.g. Blockwork Crew A" required>
        <label>Activity</label>
        <select name="activity_id" required>
          <% activities.forEach(a => { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
        </select>
        <button type="submit">Add Crew</button>
      </form>
    </div>

    <% crews.forEach(c => { %>
    <div class="card">
      <h3><%= c.name %> — <%= c.activity_name %></h3>
      <table>
        <tr><th>Worker</th><th>Incentive Share %</th></tr>
        <% members.filter(m => m.crew_id === c.id).forEach(m => { %>
          <tr><td><%= m.worker_name %></td><td><%= m.incentive_share_percent %>%</td></tr>
        <% }) %>
      </table>
      <form method="POST" action="/setup/crews/<%= c.id %>/members" style="margin-top:16px;">
        <label>Add Worker</label>
        <select name="worker_id" required>
          <% workers.forEach(w => { %><option value="<%= w.id %>"><%= w.name %></option><% }) %>
        </select>
        <label>Incentive Share (%)</label>
        <input type="number" step="0.01" name="incentive_share_percent" placeholder="60" required>
        <button type="submit">Add to Crew</button>
      </form>
    </div>
    <% }) %>
  </main>
</body>
</html>
