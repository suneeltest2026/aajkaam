<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Targets</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-supervisor">
  <%- include('../partials/nav', {current: 'setup'}) %>
  <main>
    <p style="margin:0 0 16px;"><a href="/setup">&larr; Back to Setup</a></p>
    <div class="card">
      <h2>New Target</h2>
      <p style="color:var(--steel);font-size:13px;">Leave "Project Type" blank to make this the general/default target for that stage.</p>
      <form method="POST" action="/setup/targets">
        <label>Stage</label>
        <select name="stage_id" id="stageSelect" required>
          <% stages.forEach(s => { %>
            <option value="<%= s.id %>" data-activity="<%= s.activity_id %>"><%= s.activity_name %> — <%= s.name %></option>
          <% }) %>
        </select>
        <input type="hidden" name="activity_id" id="activityIdField">

        <label>Project Type (optional)</label>
        <select name="project_type_id">
          <option value="">-- General / Default --</option>
          <% projectTypes.forEach(p => { %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
        </select>

        <label>Target Per Day</label>
        <input type="number" step="0.01" name="target_per_day" required>

        <button type="submit">Add Target</button>
      </form>
    </div>

    <div class="card">
      <h3>Existing Targets</h3>
      <div class="table-wrap">
      <table>
        <tr><th>Activity</th><th>Stage</th><th>Project Type</th><th>Target/Day</th></tr>
        <% targets.forEach(t => { %>
          <tr>
            <td><%= t.activity_name %></td>
            <td><%= t.stage_name %></td>
            <td><%= t.project_type_name || 'General' %></td>
            <td><%= t.target_per_day %></td>
          </tr>
        <% }) %>
      </table>
      </div>
    </div>
  </main>
  <script>
    const stageSelect = document.getElementById('stageSelect');
    const activityIdField = document.getElementById('activityIdField');
    function syncActivity() {
      const opt = stageSelect.options[stageSelect.selectedIndex];
      activityIdField.value = opt ? opt.dataset.activity : '';
    }
    stageSelect.addEventListener('change', syncActivity);
    syncActivity();
  </script>
</body>
</html>
