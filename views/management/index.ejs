<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Management</title><link rel="stylesheet" href="/style.css"></head>
<body class="role-management">
  <%- include('../partials/nav', {current: 'management'}) %>
  <main style="max-width:960px;">
    <div class="tiles">
      <div class="tile">
        <p class="tile-label">Active sites</p>
        <p class="tile-num"><%= activeSites %></p>
        <p class="tile-delta" style="color:var(--steel);"><%= activeWorkers %> active workers</p>
      </div>
      <div class="tile">
        <p class="tile-label">Crews on target today</p>
        <% if (crewsOnTargetPct === null) { %>
          <p class="tile-num" style="color:var(--steel);font-size:16px;">No entries yet</p>
        <% } else { %>
          <p class="tile-num"><%= crewsOnTargetPct %><span class="tile-unit">%</span></p>
          <% if (crewsOnTargetDelta === null) { %>
            <p class="tile-delta" style="color:var(--steel);">No entries yesterday to compare</p>
          <% } else if (crewsOnTargetDelta >= 0) { %>
            <p class="tile-delta tile-delta--good"><svg class="ic-sm" width="11" height="11"><use href="#i-up"></use></svg>+<%= crewsOnTargetDelta %>pts vs yesterday</p>
          <% } else { %>
            <p class="tile-delta tile-delta--warn"><svg class="ic-sm" width="11" height="11"><use href="#i-down"></use></svg><%= crewsOnTargetDelta %>pts vs yesterday</p>
          <% } %>
        <% } %>
      </div>
      <div class="tile">
        <p class="tile-label">Entries logged today</p>
        <p class="tile-num"><%= entriesToday %></p>
        <% if (entriesDelta >= 0) { %>
          <p class="tile-delta tile-delta--good"><svg class="ic-sm" width="11" height="11"><use href="#i-up"></use></svg>+<%= entriesDelta %> vs yesterday</p>
        <% } else { %>
          <p class="tile-delta tile-delta--warn"><svg class="ic-sm" width="11" height="11"><use href="#i-down"></use></svg><%= entriesDelta %> vs yesterday</p>
        <% } %>
      </div>
      <div class="tile">
        <p class="tile-label">Daily output &mdash; last 6 days</p>
        <% if (chart) { %>
          <svg class="spark" viewBox="0 0 <%= chart.w %> <%= chart.h %>" preserveAspectRatio="none">
            <line x1="0" y1="16" x2="<%= chart.w %>" y2="16" class="spark-grid"/>
            <line x1="0" y1="32" x2="<%= chart.w %>" y2="32" class="spark-grid"/>
            <line x1="0" y1="48" x2="<%= chart.w %>" y2="48" class="spark-grid"/>
            <polygon points="<%= chart.areaPoints %>" class="spark-area"/>
            <polyline points="<%= chart.linePoints %>" class="spark-line"/>
            <circle cx="<%= chart.end.x %>" cy="<%= chart.end.y %>" r="4" class="spark-end"/>
          </svg>
          <div class="spark-labels"><span><%= chart.firstLabel %></span><span><%= chart.lastLabel %></span></div>
        <% } else { %>
          <p style="color:var(--steel);font-size:12.5px;margin-top:8px;">Not enough days of data yet.</p>
        <% } %>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-bottom:4px;">Projects &amp; team assignment</h2>
      <p style="color:var(--steel);font-size:13px;margin:0 0 16px;">Who can see and log data for what &mdash; assigned in Setup &rarr; Crews.</p>
      <% projectTeams.forEach((p, i) => { %>
        <div style="padding:16px 0; <%= i > 0 ? 'border-top:1px solid var(--line);' : '' %>">
          <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:12px;">
            <p style="font-size:16px;font-weight:700;margin:0;"><%= p.name %></p>
            <div style="display:flex;gap:8px;">
              <span class="pill pill--neutral"><svg class="ic-sm" width="12" height="12"><use href="#i-crew"></use></svg><%= p.supervisorCount %> supervisor<%= p.supervisorCount === 1 ? '' : 's' %></span>
              <span class="pill pill--neutral"><svg class="ic-sm" width="12" height="12"><use href="#i-user"></use></svg><%= p.workerCount %> worker<%= p.workerCount === 1 ? '' : 's' %></span>
            </div>
          </div>

          <% if (!p.supervisors.length && !p.unassignedCrews.length) { %>
            <p style="color:var(--steel);font-size:13px;margin:0;">No crews assigned to this project yet.</p>
          <% } %>

          <% p.supervisors.forEach(s => { %>
            <div style="display:flex;gap:12px;align-items:flex-start;padding:8px 0;flex-wrap:wrap;">
              <span class="pill" style="background:var(--supervisor);color:var(--supervisor-ink);flex:none;"><%= s.name %></span>
              <span style="color:var(--steel);font-size:13px;flex:1;min-width:200px;">
                <% if (s.workers.length) { %><%= s.workers.join(', ') %><% } else { %>No workers on their crew(s) yet<% } %>
              </span>
            </div>
          <% }) %>

          <% if (p.unassignedCrews.length) { %>
            <p style="color:var(--warn-text);background:var(--warn-bg);border-radius:8px;padding:8px 10px;font-size:12.5px;margin:8px 0 0;">
              <svg class="ic-sm" width="12" height="12"><use href="#i-alert"></use></svg>
              No supervisor assigned yet for: <%= p.unassignedCrews.join(', ') %> — nobody can log entries for <%= p.unassignedCrews.length === 1 ? 'it' : 'them' %>.
            </p>
          <% } %>
        </div>
      <% }) %>
      <% if (!projectTeams.length) { %>
        <p style="color:var(--steel);">No active projects yet — add one in <a href="/setup/projects">Setup &rarr; Projects</a>.</p>
      <% } %>
    </div>

    <div class="card">
      <h2 style="margin-bottom:14px;">Crew performance &mdash; today</h2>
      <div class="table-wrap">
        <table>
          <tr><th>Crew</th><th>Site</th><th>Activity</th><th>Target vs actual</th><th>Status</th><th class="num">Members</th></tr>
          <% crews.forEach(c => { %>
            <tr>
              <td><%= c.name %></td>
              <td><%= c.projectName || '—' %></td>
              <td><%= c.activity_name %></td>
              <td>
                <% if (c.percent !== null) { %>
                  <div class="tbar"><div class="tbar-fill tbar--<%= c.status %>" style="width:<%= Math.min(100, c.percent) %>%"></div></div><span class="tbar-num"><%= c.percent %>%</span>
                <% } else { %>
                  <span style="color:var(--steel);font-size:12.5px;">—</span>
                <% } %>
              </td>
              <td>
                <% if (c.status === 'good') { %>
                  <span class="status status--good"><svg class="ic-sm" width="11" height="11"><use href="#i-check"></use></svg>On track</span>
                <% } else if (c.status === 'warn') { %>
                  <span class="status status--warn"><svg class="ic-sm" width="11" height="11"><use href="#i-dot"></use></svg>Watch</span>
                <% } else if (c.status === 'bad') { %>
                  <span class="status status--bad"><svg class="ic-sm" width="11" height="11"><use href="#i-alert"></use></svg>Behind</span>
                <% } else if (c.status === 'no-target') { %>
                  <span class="pill pill--neutral">No target set</span>
                <% } else { %>
                  <span class="pill pill--neutral">No entry today</span>
                <% } %>
              </td>
              <td class="num"><%= c.member_count %></td>
            </tr>
          <% }) %>
          <% if (!crews.length) { %>
            <tr><td colspan="6" style="color:var(--steel);">No crews yet — add some in <a href="/setup/crews">Setup &rarr; Crews</a>.</td></tr>
          <% } %>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
