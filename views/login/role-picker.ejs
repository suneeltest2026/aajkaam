<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AajKaam — Log in</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <%- include('../partials/icons') %>
  <header class="site-header"><span class="wordmark"><svg class="ic" width="18" height="18"><use href="#i-hardhat"></use></svg>AAJKAAM</span></header>
  <main>
    <div class="card">
      <h2>Who's using AajKaam?</h2>
      <p style="color:var(--steel);margin-top:-8px;">Pick your role, then your name, then your PIN.</p>

      <a href="/login?role=worker" class="role-option role-worker-card">
        <span class="role-dot"><svg class="ic" width="20" height="20"><use href="#i-hardhat"></use></svg></span>
        <span class="role-text"><b>Worker</b><span>See your daily targets &amp; pay</span></span>
        <svg class="ic ic-end" width="18" height="18" style="transform:rotate(-90deg);"><use href="#i-chevron"></use></svg>
      </a>
      <a href="/login?role=supervisor" class="role-option role-supervisor-card">
        <span class="role-dot"><svg class="ic" width="20" height="20"><use href="#i-crew"></use></svg></span>
        <span class="role-text"><b>Supervisor</b><span>Log today's work for your crew</span></span>
        <svg class="ic ic-end" width="18" height="18" style="transform:rotate(-90deg);"><use href="#i-chevron"></use></svg>
      </a>
      <a href="/login?role=management" class="role-option role-management-card">
        <span class="role-dot"><svg class="ic" width="20" height="20"><use href="#i-tasks"></use></svg></span>
        <span class="role-text"><b>Management</b><span>Track sites, crews &amp; performance</span></span>
        <svg class="ic ic-end" width="18" height="18" style="transform:rotate(-90deg);"><use href="#i-chevron"></use></svg>
      </a>
    </div>
  </main>
</body>
</html>
